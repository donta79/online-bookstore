# This is configuration only; there is no application code in the starter.
LLM_PROVIDER=ollama
OLLAMA_MODEL=gemma4
OLLAMA_BASE_URL=http://127.0.0.1:11434
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
BOOKSTORE_DATABASE_PATH=data/bookstore.db
# Streamable HTTP endpoint for the Microsoft Learn MCP server used by the
# catalogue agent's lookup_docs tool. Set to empty to disable documentation
# lookups; the agent then falls back to catalogue-only answers.
MCP_LEARN_ENDPOINT=https://learn.microsoft.com/api/mcp
